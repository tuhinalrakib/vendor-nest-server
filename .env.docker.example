# ==========================================
# VendorNest Docker Environment Configuration
# ==========================================

# Django Core Settings
SECRET_KEY=django-insecure-docker-vendornest-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (Self-Contained Docker PostgreSQL)
POSTGRES_DB=vendornest_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
DATABASE_URL=postgres://postgres:postgrespassword@db:5432/vendornest_db
DB_SSL_REQUIRE=False

# Redis & Celery (Self-Contained Docker Redis)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Gmail SMTP Configuration (App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=eng.tuhin77@gmail.com
EMAIL_HOST_PASSWORD=yhfcmcefypwxschm
DEFAULT_FROM_EMAIL=eng.tuhin77@gmail.com

# Next.js Frontend Configuration
NEXT_PUBLIC_BACKEND_HOST=http://localhost:8000
